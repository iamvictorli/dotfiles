#!/usr/bin/env bash

set -e
set -o pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASEDIR}"

if ! command -v brew &>/dev/null; then
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "Homebrew is not installed. Install it first, then rerun ./install."
    exit 1
  fi
fi

echo "Updating Homebrew and installing packages from Brewfile..."
brew update
brew bundle install --file="${BASEDIR}/Brewfile"
brew bundle upgrade --file="${BASEDIR}/Brewfile"
echo "Homebrew packages installed and upgraded."

if ! command -v stow &>/dev/null; then
  echo "GNU Stow is not installed after brew bundle install. Check Brewfile and rerun ./install."
  exit 1
fi

# List of packages to stow
STOW_DIR="${BASEDIR}/stow"

if [ ! -d "${STOW_DIR}" ]; then
  echo "Stow package directory not found: ${STOW_DIR}"
  exit 1
fi

PACKAGES=(
  agents
  ghostty
  herdr
  hunk
  lazygit
  nvim
  pi
  ssh
  starship
  yazi
  zsh
)

echo "Stowing dotfiles..."

for package in "${PACKAGES[@]}"; do
  if [ -d "${STOW_DIR}/${package}" ]; then
    echo "  Stowing $package..."
    stow -v --restow --dir="${STOW_DIR}" --target="$HOME" "$package"
  else
    echo "  Skipping $package (not found)"
  fi
done

echo "Stowing complete!"

# Install Node.js via vite-plus if available
if command -v vp &>/dev/null; then
  vp upgrade
  echo "Setting up vite-plus Node.js environment..."
  vp env setup --env-only
  vp env install lts
  vp env default lts
  echo "Installing global packages..."
  npm_config_allow_remote=all vp i --global trash-cli @earendil-works/pi-coding-agent taze chrome-devtools-mcp @openai/codex opensrc
else
  echo "vp not found. Could not set up vite-plus Node.js environment."
fi

# skills uses ~/.agents/.skill-lock.json for global installs; the agents package is stowed above.
SKILL_LOCK="${HOME}/.agents/.skill-lock.json"
if command -v npx &>/dev/null && [ -f "${SKILL_LOCK}" ]; then
  echo "Updating global agent skills from ${SKILL_LOCK}..."
  if env -u XDG_STATE_HOME npx --yes skills update --global --yes; then
    echo "Agent skills updated."
  else
    echo "Some skill updates failed; continuing."
  fi
else
  echo "npx not found or ${SKILL_LOCK} missing. Skipping skill updates."
fi

refresh_opensrc_repo() {
  local repo="$1"
  local opensrc_home="${OPENSRC_HOME:-${HOME}/.opensrc}"
  local tmp_home tmp_sources tmp_repo_rel tmp_repo_root_rel tmp_repo_name real_sources now

  tmp_home="$(mktemp -d)"

  # `opensrc fetch owner/repo` does not refresh an existing cached checkout; if
  # the expected cache path already exists, opensrc reports it as cached and
  # leaves it alone. To force a current clone without risking the only local
  # copy, fetch into a brand-new temporary opensrc cache first.
  if ! OPENSRC_HOME="$tmp_home" opensrc fetch "$repo" | sed '/^[[:space:]]*[0-9][0-9]* fetched[[:space:]]*$/d'; then
    rm -rf "$tmp_home"
    return 1
  fi

  # The temporary cache writes the canonical repo name/ref/path to sources.json.
  # Read that metadata instead of guessing branch names like main vs master.
  tmp_sources="${tmp_home}/sources.json"
  tmp_repo_rel="$(jq -r '.repos[0].path // empty' "$tmp_sources")"
  tmp_repo_name="$(jq -r '.repos[0].name // empty' "$tmp_sources")"

  if [ -z "$tmp_repo_rel" ] || [ -z "$tmp_repo_name" ]; then
    echo "  Could not locate fetched repo metadata for $repo."
    rm -rf "$tmp_home"
    return 1
  fi

  # opensrc stores refs under repos/<host>/<owner>/<repo>/<ref>. Remove the
  # whole repo directory before copying so stale branch/ref directories do not
  # linger after the refresh.
  tmp_repo_root_rel="$(dirname "$tmp_repo_rel")"
  real_sources="${opensrc_home}/sources.json"
  now="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  mkdir -p "$(dirname "${opensrc_home}/${tmp_repo_root_rel}")"
  rm -rf "${opensrc_home:?}/${tmp_repo_root_rel}"
  cp -a "${tmp_home}/${tmp_repo_root_rel}" "$(dirname "${opensrc_home}/${tmp_repo_root_rel}")/"

  # Finally, merge the freshly fetched repo metadata into the real opensrc
  # index. Package entries are preserved; the matching repo entry is replaced.
  mkdir -p "$opensrc_home"
  if [ -f "$real_sources" ]; then
    jq --argjson entry "$(jq -c '.repos[0]' "$tmp_sources")" --arg now "$now" '
      .updatedAt = $now
      | .packages = (.packages // [])
      | .repos = ((.repos // []) | map(select(.name != $entry.name)) + [$entry])
    ' "$real_sources" >"${real_sources}.tmp"
  else
    jq --arg now "$now" '{updatedAt: $now, packages: [], repos: [.repos[0]]}' "$tmp_sources" >"${real_sources}.tmp"
  fi
  mv "${real_sources}.tmp" "$real_sources"

  rm -rf "$tmp_home"
}

if command -v opensrc &>/dev/null && command -v jq &>/dev/null && [ -f "${BASEDIR}/opensrc-repos" ]; then
  echo "Refreshing source repos with opensrc..."
  opensrc_failed=0

  while IFS= read -r repo || [ -n "$repo" ]; do
    # Skip blank lines and comments.
    [[ "$repo" =~ ^[[:space:]]*(#|$) ]] && continue

    # Trim leading/trailing whitespace.
    repo="${repo#"${repo%%[![:space:]]*}"}"
    repo="${repo%"${repo##*[![:space:]]}"}"

    echo "  Updating $repo..."
    if ! refresh_opensrc_repo "$repo"; then
      echo "  Failed to update $repo; leaving any existing cached copy in place."
      opensrc_failed=1
    fi
  done <"${BASEDIR}/opensrc-repos"

  if [ "$opensrc_failed" -ne 0 ]; then
    echo "Some opensrc repo installs failed; continuing."
  fi
else
  echo "opensrc, jq, or ${BASEDIR}/opensrc-repos missing. Skipping source repo install."
fi

echo "Done!"
